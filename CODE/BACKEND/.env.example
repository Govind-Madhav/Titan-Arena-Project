PORT=5000
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/esports_tournament"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
CAPTAIN_BONUS_PERCENT=10

# Firebase (required for auth)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://e-sports-tournament-ba4c6-default-rtdb.asia-southeast1.firebasedatabase.app
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}' (production: set this as JSON string)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json (alternative to JSON)

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD= (leave empty for local dev, set in production)

# Frontend / app URL for verification links and emails
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# CORS (Express) and Socket.io allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Worker Health Port
WORKER_HEALTH_PORT=5001

# ─── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys for development, LIVE keys for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Java Tournament Engine URL (default: http://localhost:8080)
JAVA_ENGINE_URL=http://localhost:8080
